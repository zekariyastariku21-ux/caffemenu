                                    image
                                        ? `
                                            <img
                                                src="${escapeAttributeForAdmin(image)}"
                                                alt="${escapeAttributeForAdmin(
                                                    item.name || ''
                                                )}"
                                            >
                                        `
                                        : `
                                            <span>
                                                Â­Â
                                            </span>
                                        `
                                }
                            </div>


                            <div
                                class="day-special-current-info"
                            >
                                <strong>
                                    ${escapeHtmlForAdmin(
                                        item.name ||
                                        'Unnamed item'
