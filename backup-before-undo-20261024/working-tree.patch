+function encryptTelebirrSecret(value) {
+  if (typeof value !== 'string' || !value.trim()) {
+    throw new Error('A non-empty secret is required for encryption.');
+  }
+
+  const configuredKey =
+    process.env.TELEBIRR_SETTINGS_ENCRYPTION_KEY || '';
+
+  if (!/^[a-f0-9]{64}$/i.test(configuredKey)) {
+    throw new Error(
+      'TELEBIRR_SETTINGS_ENCRYPTION_KEY must be a 32-byte hex key.'
+    );
+  }
+
+  const key = Buffer.from(configuredKey, 'hex');
+  const iv = crypto.randomBytes(12);
+  const cipher = crypto.createCipheriv('aes-256-gcm', key, iv);
+  const encrypted = Buffer.concat([
+    cipher.update(value, 'utf8'),
+    cipher.final()
+  ]);
+  const tag = cipher.getAuthTag();
+
+  return [
+    'v1',
+    iv.toString('hex'),
+    tag.toString('hex'),
+    encrypted.toString('hex')
+  ].join(':');
+}
+
+function isValidTelebirrUrl(value) {
+  if (typeof value !== 'string' || !value.trim()) return true;
+
+  try {
+    const parsed = new URL(value.trim());
+    return parsed.protocol === 'https:' ||
+      (
+        parsed.protocol === 'http:' &&
+        ['localhost', '127.0.0.1', '::1'].includes(parsed.hostname)
+      );
+  } catch {
+    return false;
+  }
+}
