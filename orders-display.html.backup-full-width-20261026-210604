<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Customer Orders | CaffeMenu</title>
  <style>
  :root {
    color-scheme: dark;
    --bg: #17120f;
    --panel: #241b16;
    --gold: #d8ad62;
    --cream: #f8f0df;
    --muted: #b9aa98;
    --line: #49372b;
    font-family: Arial, sans-serif;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--cream);
    font-family: Arial, sans-serif;
    min-height: 100vh;
  }

  main {
    max-width: 1100px;
    margin: auto;
    padding: 28px 18px;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    flex-wrap: wrap;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  h1 { margin: 0; font-size: 22px; letter-spacing: .2px; }
  h3 { color: var(--gold); font-size: 17px; margin: 16px 0 0; }

  button {
    border: 1px solid var(--line);
    border-radius: 9px;
    padding: 11px 15px;
    cursor: pointer;
    background: #302116;
    color: var(--cream);
    font-weight: bold;
    transition: background .15s ease, transform .15s ease;
  }

  button:hover { background: #49301d; }
  button:active { transform: scale(.98); }
  button:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  #message {
    color: var(--gold);
    min-height: 22px;
    margin: 18px 0;
  }

  #orders {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 14px;
    align-items: start;
  }

  .order {
    min-width: 0;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 17px;
    overflow-wrap: anywhere;
    transition: border-color .15s ease;
  }

  .order:hover { border-color: #80643b; }

  .order-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }

  .order-head strong { font-size: 17px; line-height: 1.4; }

  .status {
    display: inline-block;
    flex-shrink: 0;
    background: #30251a;
    border: 1px solid #80643b;
    color: var(--gold);
    border-radius: 30px;
    padding: 5px 9px;
    font-size: 12px;
    white-space: nowrap;
    text-transform: capitalize;
  }

  .muted {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .order > p { margin: 9px 0; line-height: 1.5; font-size: 14px; }
  .order > p.muted { margin: 7px 0 14px; }

  .items {
    border-top: 1px solid var(--line);
    padding: 12px 0 0 20px;
    margin: 12px 0 0;
  }

  .items li {
    padding: 7px 0;
    font-size: 14px;
    line-height: 1.5;
  }

  .items li + li { border-top: 1px solid rgba(73, 55, 43, .55); }
  .items .muted { margin-top: 4px; }

  .empty {
    grid-column: 1 / -1;
    background: var(--panel);
    border: 1px dashed var(--line);
    border-radius: 14px;
    padding: 30px;
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 520px) {
    main { padding: 20px 13px; }
    h1 { font-size: 19px; }
    .order { padding: 15px; }
    .order-head strong { font-size: 16px; }
    button { padding: 10px 12px; }
  }
</style>
</head>
<body>
<main>
  <header>
    <div>
      <h1>Customer Orders</h1>
      <p id="restaurantName" class="muted">Loading restaurant...</p>
    </div>
    <button id="refreshButton" type="button">Refresh orders</button>
  </header>
  <p id="message" role="status">Loading orders...</p>
  <section id="orders" aria-live="polite"></section>
</main>
<script>
(() => {
  const token = localStorage.getItem('adminToken') || '';
  const slug = (
    localStorage.getItem('adminRestaurantSlug') ||
    localStorage.getItem('selectedRestaurantSlug') ||
    ''
  ).trim();

  const message = document.getElementById('message');
  const ordersContainer = document.getElementById('orders');

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, character => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;',
      '"': '&quot;', "'": '&#39;'
    })[character]);
  }

  function formatDate(value) {
    const date = new Date(value);
    return Number.isNaN(date.getTime()) ? '' : date.toLocaleString();
  }

  async function loadOrders() {
    if (!token || !slug) {
      message.textContent = 'Please sign in to the admin panel and select a restaurant first.';
      ordersContainer.replaceChildren();
      return;
    }

    message.textContent = 'Loading orders...';

    try {
      const response = await fetch(
        `/api/admin/orders/${encodeURIComponent(slug)}`,
        { headers: { Authorization: `Bearer ${token}` }, cache: 'no-store' }
      );
      const data = await response.json();

      if (!response.ok || data?.ok !== true) {
        throw new Error(data?.message || 'Unable to load orders.');
      }

      document.getElementById('restaurantName').textContent = data.restaurant.name;
      const orders = Array.isArray(data.orders) ? data.orders : [];

      if (!orders.length) {
        message.textContent = 'No orders have been placed yet.';
        ordersContainer.innerHTML = '<div class="empty">New customer orders will appear here.</div>';
        return;
      }

      message.textContent = `${orders.length} recent order(s).`;
      ordersContainer.innerHTML = orders.map(order => {
        const items = Array.isArray(order.items) ? order.items : [];
        const itemMarkup = items.map(item => `
          <li>${escapeHtml(item.quantity)} × ${escapeHtml(item.name)}
            — ${escapeHtml(item.price)} ETB each
            ${item.note ? `<div class="muted">Note: ${escapeHtml(item.note)}</div>` : ''}
          </li>
        `).join('');

        return `
          <article class="order">
            <div class="order-head">
              <strong>Order #${escapeHtml(order.display_number ?? order.id)}</strong>
              <span class="status">${escapeHtml(order.status)}</span>
            </div>
            <p class="muted">${escapeHtml(formatDate(order.created_at))}</p>
            <p><strong>Customer:</strong> ${escapeHtml(order.customer_name)}</p>
            <p><strong>Phone:</strong> ${escapeHtml(order.customer_phone)}</p>
            <p><strong>Branch:</strong> ${escapeHtml(order.branch_name)}</p>
            <p><strong>Order type:</strong> ${escapeHtml(order.order_type)}</p>
            ${order.table_number ? `<p><strong>Table:</strong> ${escapeHtml(order.table_number)}</p>` : ''}
            ${order.customer_address ? `<p><strong>Address:</strong> ${escapeHtml(order.customer_address)}</p>` : ''}
            <strong>Items</strong>
            <ul class="items">${itemMarkup}</ul>
            <h3>Total: ${escapeHtml(order.total)} ETB</h3>
          </article>
        `;
      }).join('');
    } catch (error) {
      message.textContent = error.message || 'Unable to load orders.';
      ordersContainer.replaceChildren();
    }
  }

  document.getElementById('refreshButton').addEventListener('click', loadOrders);
  loadOrders();
})();
</script>
</body>
</html>


