/* ================================================================
   GENERAL ERROR HANDLER
   ================================================================ */

app.use(
  (error, req, res, next) => {
    console.error(
      '[server] Unhandled error:',
      error
    );

    if (res.headersSent) {
      return next(error);
    }

    return res.status(500).json({
      ok: false,
      message:
        'Internal server error.'
    });
  }
);




