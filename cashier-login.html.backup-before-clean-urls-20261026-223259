<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>CaffeMenu | Cashier Sign In</title>
<style>
:root{color-scheme:dark;--bg:#17120f;--panel:#241b16;--gold:#d8ad62;--cream:#f8f0df;--muted:#b9aa98;--line:#49372b}
*{box-sizing:border-box}body{margin:0;min-height:100vh;background:radial-gradient(ellipse at top,#392719,var(--bg) 65%);font-family:Arial,sans-serif;color:var(--cream);display:grid;place-items:center;padding:22px}
main{width:min(100%,420px);background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:30px;box-shadow:0 18px 60px #0005}
.eyebrow{color:var(--gold);font-size:12px;font-weight:bold;letter-spacing:2px;text-transform:uppercase}h1{margin:12px 0 8px}p{color:var(--muted);line-height:1.5}label{display:block;margin:24px 0 8px;font-weight:bold}
input{width:100%;padding:15px;border:1px solid var(--line);border-radius:10px;background:#130f0d;color:var(--cream);font-size:22px;letter-spacing:8px;text-align:center}
button{width:100%;margin-top:18px;border:0;border-radius:10px;padding:14px;background:var(--gold);color:#24170c;font-size:15px;font-weight:bold;cursor:pointer}button:disabled{opacity:.6;cursor:wait}#message{min-height:24px;color:var(--gold);font-size:14px}
</style>
</head>
<body><main>
<div class="eyebrow">CaffeMenu · Cashier</div>
<h1>Cashier sign in</h1>
<p id="restaurantLabel">Enter your restaurant’s shared cashier PIN to view orders.</p>
<form id="loginForm">
<label for="pin">Shared PIN</label>
<input id="pin" type="password" inputmode="numeric" autocomplete="current-password" pattern="[0-9]{6,12}" minlength="6" maxlength="12" required>
<button type="submit">Sign In</button>
</form>
<p id="message" role="status"></p>
</main>
<script>
(function(){
 const slug=(new URLSearchParams(location.search).get('restaurant')||'').trim();
 const form=document.getElementById('loginForm'),pin=document.getElementById('pin'),message=document.getElementById('message');
 if(!slug){message.textContent='Restaurant not identified. Open the cashier sign-in link supplied by your administrator.';form.querySelector('button').disabled=true;return;}
 document.getElementById('restaurantLabel').textContent='Restaurant: '+slug+'. Enter the shared 6–12 digit cashier PIN.';
 form.addEventListener('submit',async e=>{
   e.preventDefault();
   if(!/^[0-9]{6,12}$/.test(pin.value)){message.textContent='Enter a valid 6–12 digit PIN.';return;}
   const button=form.querySelector('button');button.disabled=true;message.textContent='Signing in…';
   try{
     const r=await fetch('/api/cashier/login/'+encodeURIComponent(slug),{method:'POST',credentials:'same-origin',headers:{'Content-Type':'application/json'},body:JSON.stringify({pin:pin.value}),cache:'no-store'});
     const d=await r.json();if(!r.ok)throw new Error(d.message||'Sign in failed.');
     location.href='/cashier-orders.html?restaurant='+encodeURIComponent(slug);
   }catch(err){message.textContent=err.message;pin.value='';pin.focus();}finally{button.disabled=false;}
 });
})();
</script></body></html>
